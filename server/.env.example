# Server
PORT=5000

# ExchangeRate provider (free, no key required)
# Override if you have a paid key: https://v6.exchangerate-api.com/v6/YOUR_KEY/latest/BASE
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_API_KEY=

# Trend provider (free, no key — 201 currencies)
TREND_API_URL=https://api.frankfurter.dev/v2

# SQLite file location
SQLITE_PATH=./data/app.db

# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173
